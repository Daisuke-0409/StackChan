# Settings for the CRM relay (gateway/crm_relay.py), not the gateway.
#
# Copy to .env.crm_relay on the PC that can reach the CRM -- today the office
# PC, where the CRM runs on localhost. Nothing about the robot lives here:
# this process carries one question and four fields of the answer.

# Shared with the gateway, which sends it as X-Tachikoma-Token. The relay
# refuses to start without one, because it listens on the tailnet and would
# otherwise put the customer ledger one request from anything on it.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
CRM_RELAY_TOKEN=

# Where the CRM is. Today it is this same PC. When the CRM moves to the NAS,
# change this one line and delete nothing else -- then, once the gateway can
# reach the NAS directly, delete this relay entirely.
CRM_BASE_URL=http://127.0.0.1:8765

# Sent on to the CRM once it ships /api/tachikoma/lookup (see
# docs/CRM_LOOKUP_API_REQUEST.md). Leave empty while the relay is still
# falling back to /api/field/search, which admits us by origin instead.
CRM_TOKEN=

# Listen where the gateway can reach it. The gateway is at the other site, so
# this cannot be localhost-only.
CRM_RELAY_HOST=0.0.0.0
CRM_RELAY_PORT=8767

# Spoken aloud, so the cap is what a person can hold in their head. The true
# total is still reported, so the robot can say "there are seven -- which one?"
CRM_RELAY_MAX_RESULTS=3

CRM_RELAY_TIMEOUT_SECONDS=10
