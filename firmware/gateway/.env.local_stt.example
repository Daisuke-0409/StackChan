# Settings for the local speech recogniser (gateway/local_stt.py).
#
# Copy to .env.local_stt on the machine running the gateway. Nothing here
# is a credential: this process holds no keys and answers only to this
# machine.

# Japanese-specialised distillation of large-v3: several times faster for
# close to the same Japanese accuracy, which matters on a CPU. Swap for
# "large-v3" if a GPU ever appears, or "small" to trade accuracy for speed.
LOCAL_STT_MODEL=kotoba-tech/kotoba-whisper-v2.0-faster

# int8 on CPU. float16 needs an NVIDIA card.
LOCAL_STT_DEVICE=cpu
LOCAL_STT_COMPUTE_TYPE=int8

# Context for the decoder, not an instruction to produce these words --
# which is the difference between biasing what it expects to hear and
# telling it to write a name down. The Gemini prompt could only do the
# latter, and put 大輔 at the end of sentences nobody said it in.
LOCAL_STT_VOCABULARY=タチコマ、大輔、ダイボ石材、加江田、佐土原、田野、綾、篠崎、染川、霊標管理表、墓所、区画、宮崎

# Loopback only. Nothing else needs to reach it, and it handles speech.
LOCAL_STT_HOST=127.0.0.1
LOCAL_STT_PORT=9000

# Skips silence rather than letting the model narrate it. Whisper will
# invent a polite closing sentence over a quiet clip if allowed to.
LOCAL_STT_VAD=1
