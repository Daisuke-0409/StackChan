# ============================================================
# タチコマ ゲートウェイ設定テンプレート
# これを .env にコピーして値を埋める。.env は gitignore 済み。
# 秘密はこのファイルには書かない。在り処と入れ方だけ。
# ============================================================

# --- AI プロバイダ (Gemini) ---
AI_PROVIDER=gemini
# Gemini API キー。Google AI Studio で発行。**gitに入れない**
AI_PROVIDER_API_KEY=
AI_PROVIDER_TIMEOUT_SECONDS=30
ENABLE_WEB_SEARCH=1

# --- デバイス認証 ---
# 機体の bearer token。**カンマ区切りで複数台**分。
# ESP32 に焼いた TACHIKOMA_DEVICE_TOKEN と一致させる。
# 会社の機体を足すときは copy_device_token.ps1 で運ぶ (指紋 dde5d869)
DEVICE_TOKEN=
# 開発時のみ 1。実運用は空 (平文HTTP・mockを許可してしまう)
ALLOW_INSECURE_DEV=

# --- ネットワーク ---
# 実機がLAN経由で叩くので 0.0.0.0 必須 (127.0.0.1 だと機体が届かない)
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080

# --- 音声認識 (STT) ---
# local = ローカルWhisper(推奨・固有名詞に強い) / gemini = クラウド
STT_PROVIDER=local
STT_PROVIDER_URL=http://127.0.0.1:9000/v1/audio/transcriptions
STT_PROVIDER_API_KEY=local
# STTに文脈として渡す固有名詞(推測での混入を防ぐ)。1語だけが一番危険
STT_VOCABULARY=タチコマ,大輔,ダイボ石材,加江田,佐土原,田野,綾,篠崎,染川,霊標,管理表,墓所,区画,宮崎,霊園

# --- 音声合成 (TTS) ---
TTS_PROVIDER=voicevox
VOICEVOX_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER=3
GEMINI_TTS_VOICE=Zephyr

# --- CRM連携 (会社の墓所台帳) ---
# 会社PCの照会役(crm_relay)のTailscaleアドレス
CRM_RELAY_URL=http://100.76.60.88:8767
# 会社の .env.crm_relay と同じ値。setup_crm_relay_token.ps1 で運ぶ(指紋 d0db6880)
CRM_RELAY_TOKEN=
# この機体IDに話しかけたときだけ会社モニターに表示(会社の体のID)
CRM_OFFICE_DEVICE_IDS=
