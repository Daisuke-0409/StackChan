# Settings for the forwarder (gateway/forwarder.py), not the gateway.
#
# Copy to .env.forwarder on the PC that has a body but no gateway -- the
# office PC. Nothing here is a credential: this process carries traffic and
# never reads it, so the office PC needs no API key and no DEVICE_TOKEN.

# The gateway's Tailscale address. Not its LAN address: that belongs to the
# other site's network and means nothing from here. Find it on the gateway's
# own machine with `tailscale ip -4`, and put it in .env.forwarder rather than
# here -- this file is committed, and a tailnet address names the machine that
# holds every conversation.
FORWARDER_TARGET=http://100.x.y.z:8080

# Listen on every interface so the robot on this LAN can reach it. The robot's
# provisioned gateway URL points at this PC's LAN address and this port.
FORWARDER_HOST=0.0.0.0
FORWARDER_PORT=8080

# Long enough for a reply that had to search the web, short enough that a hung
# link does not hold a worker thread all evening.
FORWARDER_TIMEOUT_SECONDS=60
